
{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bro Lang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#key-value"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bro",
          "match": "//.*$"
        }
      ]
    },
    "key-value": {
      "patterns": [
        {
          "name": "entity.name.tag.os.bro",
          "match": "^\\s*[A-Za-z0-9_-]+(?=\\s*:)"
        },
        {
          "name": "punctuation.separator.key-value.bro",
          "match": ":"
        },
        {
          "name": "string.unquoted.path.bro",
          "match": "(?<=:)\\s*[^\\r\\n]+"
        }
      ]
    }
  },
  "scopeName": "source.bro"
}
