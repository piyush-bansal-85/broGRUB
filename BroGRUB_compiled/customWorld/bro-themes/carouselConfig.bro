// this file contains the configuration for the carousel.
// the carousel_side_scale_num is the numerator and carousel_side_scale_den is the denominator for the carousel side to scale., it will decide how much space it will take on the screen.

icon_width:48
icon_height:48
icon_gap:12
carousel_side_scale_num:4
carousel_side_scale_den:6
carousel_min_width:320
carousel_min_height:180
carousel_gap:100
carousel_text_gap:50